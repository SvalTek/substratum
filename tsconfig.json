{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "erasableSyntaxOnly": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "noEmit": true,
    "lib": ["ES2022", "DOM"], "types": []
  },
  "include": ["src/**/*.ts"]
}
