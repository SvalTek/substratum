{
  "name": "@svaltek/substratum",
  "version": "0.1.0",
  "description": "A reactive spatial runtime for composable systems.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SvalTek/substratum.git"
  },
  "homepage": "https://svaltek.github.io/substratum/",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./bundle": {
      "types": "./src/mod.ts",
      "import": "./dist/substratum.esm.js",
      "default": "./dist/substratum.esm.js"
    }
  },
  "types": "./src/mod.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:bundle": "bun build src/mod.ts --outdir=dist --entry-naming=substratum.esm.js --format=esm --target=browser --sourcemap=linked",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && bun tests/runtime.test.ts",
    "test:node": "tsc -p tsconfig.test.json && node --experimental-strip-types tests/runtime.test.ts",
    "benchmark": "bun benchmarks/index.ts",
    "example": "bun examples/warehouse.ts",
    "example:node": "node --experimental-strip-types examples/warehouse.ts",
    "benchmark:node": "node --experimental-strip-types benchmarks/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitepress": "^1.6.3"
  }
}
